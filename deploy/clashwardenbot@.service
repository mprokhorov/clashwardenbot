# One instance per bot: clashwardenbot@1 runs `bot_polling.py --bot_number=1` and so on
[Unit]
Description=ClashWardenBot instance %i
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=clashwardenbot
Group=clashwardenbot
WorkingDirectory=/opt/clashwardenbot/app
ExecStart=/opt/clashwardenbot/app/.venv/bin/python bot_polling.py --bot_number=%i
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Restart=always
RestartSec=10
LogNamespace=clashwardenbot
SyslogIdentifier=clashwardenbot-%i
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
